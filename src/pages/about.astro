---
import Header from "../components/Header.astro";

const team = [
  {
    number: "01",
    name: "THE FOUNDER",
    role: "VISION & DIRECTION",
    description: "Exploring ideas and shaping the direction of SAEO LABS.",
    image: "/images/team-founder.jpg"
  },
  {
    number: "02",
    name: "THE BUILDER",
    role: "PRODUCT & ENGINEERING",
    description: "Turning concepts into functional products and systems.",
    image: "/images/team-builder.jpg"
  },
  {
    number: "03",
    name: "THE RESEARCHER",
    role: "RESEARCH & STRATEGY",
    description: "Connecting knowledge, discovering opportunities, and testing possibilities.",
    image: "/images/team-researcher.jpg"
  }
];
---

<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content="Discover SAEO LABS, an independent venture studio exploring ideas and building possibilities." />
  <title>About — SAEO LABS</title>
</head>

<body>

  <div class="site-frame">

    <Header active="about" variant="editorial" />

    <main>

      <!-- ABOUT HERO -->

      <section class="about-hero">

        <h1>About</h1>

        <div class="intro-grid">

          <!-- SUMMARY / MISSION -->

          <div class="intro-text">

            <article class="text-block" id="summary">

              <div class="label">Summary</div>

              <p>
                SAEO LABS is an independent venture studio exploring ideas,
                building products, and discovering new possibilities.
                We connect knowledge, technology, and creativity
                to turn possibilities into reality.
              </p>

              <details class="detail">
                <summary>VIEW DETAILS ↗</summary>
                <div class="detail-content">
                  <p>
                    SAEO LABS began with curiosity about how things work,
                    how ideas connect, and how technology can create
                    meaningful opportunities.
                  </p>
                  <p>
                    We explore different fields, experiment with concepts,
                    and develop independent projects.
                    Each project is an opportunity to learn,
                    test an idea, and create something useful.
                  </p>
                </div>
              </details>

            </article>

            <article class="text-block" id="mission">

              <div class="label">Mission</div>

              <p>
                Our mission is to transform curiosity into creation.
                We explore, experiment, and build with the belief
                that every small idea can lead to something greater.
              </p>

              <details class="detail">
                <summary>VIEW DETAILS ↗</summary>
                <div class="detail-content">
                  <p>
                    We believe that learning should lead to action.
                    Knowledge becomes more valuable when it is applied,
                    tested, and transformed into real experiences.
                  </p>
                  <p>
                    Our goal is to build products and services
                    that solve problems, connect people,
                    and create lasting value.
                  </p>
                </div>
              </details>

            </article>

          </div>

          <!-- ARCHITECTURE IMAGE -->

          <div class="architecture">

            <div class="architecture-title">
              SAEO LABS
            </div>

            <img
              src="/images/saeo-building.jpg"
              alt="Modern architectural building representing SAEO LABS"
            />

            <span class="image-caption">
              INDEPENDENT THINKING. CONTINUOUS BUILDING.
            </span>

          </div>

        </div>

      </section>


      <!-- OUR TEAM -->

      <section class="team-section">

        <div class="team-heading">
          <h2>OUR TEAM</h2>
          <p>
            A collection of virtual identities representing
            the different roles and disciplines within SAEO LABS.
          </p>
        </div>

        <div class="team-grid">

          {team.map((member) => (
            <article class="team-member">

              <div class="member-image">
                <img
                  src={member.image}
                  alt={`AI virtual profile representing ${member.role}`}
                  loading="lazy"
                />
              </div>

              <div class="member-info">

                <span class="member-number">
                  {member.number}
                </span>

                <h3>{member.name}</h3>

                <span class="member-role">
                  {member.role}
                </span>

                <p>{member.description}</p>

              </div>

            </article>
          ))}

        </div>

        <p class="team-note">
          * VIRTUAL TEAM — AI-GENERATED REPRESENTATIONS
        </p>

      </section>


      <!-- CLOSING -->

      <section class="closing">

        <p>SAEO LABS</p>

        <h2>
          Ideas are only<br />
          the beginning.
        </h2>

        <a href="/ventures">
          EXPLORE OUR VENTURES ↗
        </a>

      </section>

    </main>


    <footer>
      <span>SAEO LABS © 2026</span>
      <a href="/">BACK TO HOME ↑</a>
    </footer>

  </div>

</body>
</html>


<style>
  :global(*) {
    box-sizing: border-box;
  }

  :global(body) {
    margin: 0;
    background: #b9b9b9;
    color: #080808;
    font-family: Arial, Helvetica, sans-serif;
  }

  .site-frame {
    width: calc(100% - 10.3%);
    max-width: 1500px;
    margin: 60px auto;
    background: white;
    min-height: 100vh;
  }

  main {
    padding: 0 10px;
  }


  /* ABOUT */

  .about-hero {
    padding-top: 62px;
  }

  .about-hero h1 {
    font-size: clamp(70px, 8vw, 104px);
    font-weight: 500;
    letter-spacing: -6px;
    line-height: 1;
    margin: 0 0 20px;
  }

  .intro-grid {
    display: grid;
    grid-template-columns: 1fr 1.05fr;
    gap: 7%;
    align-items: start;
  }

  .intro-text {
    padding-top: 25px;
  }

  .text-block {
    margin-bottom: 26px;
    max-width: 420px;
  }

  .label {
    color: #888;
    font-family: "Courier New", monospace;
    font-size: 13px;
    margin-bottom: 7px;
  }

  .text-block > p {
    font-family: "Courier New", monospace;
    font-size: 13px;
    line-height: 1.35;
    margin: 0;
    color: #111;
  }


  /* DETAILS */

  .detail {
    margin-top: 13px;
    text-align: right;
    font-family: "Courier New", monospace;
    font-size: 10px;
  }

  .detail summary {
    display: inline-block;
    cursor: pointer;
    list-style: none;
    border-bottom: 1px solid #111;
    padding-bottom: 3px;
  }

  .detail summary::-webkit-details-marker {
    display: none;
  }

  .detail-content {
    text-align: left;
    margin-top: 15px;
    padding: 15px;
    background: #f5f5f5;
  }

  .detail-content p {
    font-size: 12px;
    line-height: 1.7;
  }


  /* ARCHITECTURE */

  .architecture {
    height: 400px;
    background: #e5e5e5;
    position: relative;
    overflow: hidden;
    display: flex;
    justify-content: center;
    align-items: flex-end;
  }

  .architecture-title {
    position: absolute;
    top: 15px;
    left: 50%;
    transform: translateX(-50%);
    z-index: 1;
    white-space: nowrap;
    font-size: clamp(65px, 8vw, 112px);
    font-weight: 600;
    letter-spacing: -6px;
    line-height: 1;
    color: #000;
  }

  .architecture img {
    position: relative;
    z-index: 2;
    width: 100%;
    height: 78%;
    object-fit: cover;
    object-position: center;
    mix-blend-mode: multiply;
  }

  .image-caption {
    position: absolute;
    bottom: 10px;
    left: 12px;
    z-index: 3;
    font-family: "Courier New", monospace;
    font-size: 8px;
    letter-spacing: 1px;
  }


  /* TEAM */

  .team-section {
    margin-top: 145px;
    padding-bottom: 80px;
  }

  .team-heading {
    display: grid;
    grid-template-columns: 1fr 2fr;
    gap: 30px;
    margin-bottom: 30px;
  }

  .team-heading h2 {
    font-family: "Courier New", monospace;
    font-size: 20px;
    font-weight: 600;
    margin: 0;
  }

  .team-heading p {
    max-width: 380px;
    font-family: "Courier New", monospace;
    color: #777;
    font-size: 11px;
    line-height: 1.6;
    margin: 0;
  }

  .team-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 3.5%;
    margin-left: 28%;
  }

  .team-member {
    min-width: 0;
  }

  .member-image {
    width: 100%;
    aspect-ratio: 0.83;
    background: #e5e5e5;
    overflow: hidden;
  }

  .member-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    filter: grayscale(100%);
    transition: filter 0.4s ease;
  }

  .team-member:hover .member-image img {
    filter: grayscale(0%);
  }

  .member-info {
    padding-top: 15px;
    font-family: "Courier New", monospace;
  }

  .member-number {
    font-size: 10px;
    color: #888;
  }

  .member-info h3 {
    font-family: Arial, Helvetica, sans-serif;
    font-size: 16px;
    font-weight: 600;
    margin: 8px 0;
  }

  .member-role {
    font-size: 9px;
    letter-spacing: 1px;
    color: #888;
  }

  .member-info p {
    font-size: 11px;
    line-height: 1.6;
    color: #666;
  }

  .team-note {
    margin: 30px 0 0 28%;
    font-family: "Courier New", monospace;
    font-size: 9px;
    color: #999;
    letter-spacing: 1px;
  }


  /* CLOSING */

  .closing {
    padding: 90px 0;
    border-top: 1px solid #ddd;
  }

  .closing > p {
    font-family: "Courier New", monospace;
    font-size: 11px;
  }

  .closing h2 {
    font-size: clamp(45px, 7vw, 85px);
    letter-spacing: -4px;
    font-weight: 500;
    line-height: 1.05;
  }

  .closing a {
    color: #111;
    font-family: "Courier New", monospace;
    font-size: 10px;
    text-decoration: none;
    border-bottom: 1px solid #111;
    padding-bottom: 5px;
  }


  /* FOOTER */

  footer {
    min-height: 55px;
    padding: 20px 10px;
    display: flex;
    justify-content: space-between;
    border-top: 1px solid #aaa;
    font-family: "Courier New", monospace;
    font-size: 10px;
  }

  footer a {
    color: #111;
    text-decoration: none;
  }


  /* MOBILE */

  @media (max-width: 700px) {

    .site-frame {
      width: calc(100% - 24px);
      margin: 12px auto;
    }

    .about-hero {
      padding-top: 45px;
    }

    .about-hero h1 {
      font-size: 68px;
      letter-spacing: -4px;
    }

    .intro-grid {
      grid-template-columns: 1fr;
      gap: 30px;
    }

    .intro-text {
      padding-top: 10px;
    }

    .architecture {
      height: 300px;
    }

    .architecture-title {
      font-size: 65px;
      letter-spacing: -4px;
    }

    .team-section {
      margin-top: 85px;
    }

    .team-heading {
      grid-template-columns: 1fr;
      gap: 15px;
    }

    .team-grid {
      grid-template-columns: 1fr 1fr;
      margin-left: 0;
      gap: 25px 15px;
    }

    .team-note {
      margin-left: 0;
    }

    .closing {
      padding: 65px 0;
    }

    footer {
      font-size: 9px;
    }
  }

  @media (max-width: 400px) {
    .team-grid {
      grid-template-columns: 1fr;
    }
  }

  .team-section {
  display: grid;
  grid-template-columns: 1fr 3fr;
  gap: 30px;
}

.team-heading {
  display: block;
}

.team-grid {
  margin-left: 0;
}

.team-note {
  grid-column: 2;
  margin-left: 0;
}

@media (max-width: 700px) {
  .team-section {
    grid-template-columns: 1fr;
  }

  .team-note {
    grid-column: 1;
  }
}
</style>