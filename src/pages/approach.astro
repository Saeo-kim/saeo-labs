
---
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import { cycle, venturesInPhase } from "../data/approach";
import { ventureSlug } from "../data/ventures";

const center = 200;
const radius = 138;
const pointAt = (degrees: number) => ({
  x: center + radius * Math.cos((degrees * Math.PI) / 180),
  y: center + radius * Math.sin((degrees * Math.PI) / 180),
});
const stepDegrees = 360 / cycle.length;
const ringNodes = cycle.map((phase, index) => ({ phase, ...pointAt(-90 + index * stepDegrees) }));
const ringArrows = cycle.map((_, index) => {
  const degrees = -90 + stepDegrees / 2 + index * stepDegrees;
  return { ...pointAt(degrees), rotate: degrees + 90 };
});
---

<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Our Approach — SAEO LABS</title>
  <meta name="description" content="How SAEO LABS explores ideas, experiments, and builds products." />
</head>
<body>
  <Header active="approach" />

  <main>
    <section class="hero">
      <p class="eyebrow">SAEO LABS / OUR APPROACH</p>
      <h1>We learn by<br />moving forward<span>.</span></h1>
      <p class="intro">
        We don't expect every idea to begin with a perfect plan.
        We believe clarity comes through exploration, experimentation,
        and the process of making things real.
      </p>
      <div class="hero-note">
        A FLEXIBLE PROCESS FOR AN EVER-CHANGING WORLD.
      </div>
    </section>

    <section class="statement">
      <div class="section-label">01 / THE PRINCIPLE</div>
      <div>
        <h2>Start with a question.<br />Discover the next step.</h2>
        <p>
          Not everything needs to be figured out before we begin.
          Sometimes the best way to understand a problem is to work
          on it, test an idea, and see what becomes possible.
        </p>
        <p>
          Independent, not isolated: each phase is ours to decide and answer
          for, and each one depends on users, markets, tools, and specialists
          outside the studio. Explore and Experiment happen in Research and
          Validate. Build and Operate keep their names.
        </p>
      </div>
    </section>

    <section class="process">
      <div class="process-side">
        <div class="section-label">02 / THE OPERATING CYCLE</div>
        <svg class="ring" viewBox="0 30 400 340" role="img" aria-label="A closed loop: Research, Build, Validate, Operate, Monetize, then back to Research.">
          <circle cx={center} cy={center} r={radius} fill="none" stroke="#cfc9d8" stroke-width="1.5" />
          {ringArrows.map((arrow) => (
            <path d="M-5 -7 L5 0 L-5 7" fill="none" stroke="#8061c8" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" transform={`translate(${arrow.x.toFixed(1)} ${arrow.y.toFixed(1)}) rotate(${arrow.rotate})`} />
          ))}
          {ringNodes.map((node) => (
            <a href={`#${node.phase.id}`}>
              <rect x={(node.x - 58).toFixed(1)} y={(node.y - 18).toFixed(1)} width="116" height="36" rx="18" fill="#f7f6f2" stroke="#8061c8" stroke-width="1.5" />
              <text x={node.x.toFixed(1)} y={(node.y + 4.5).toFixed(1)} text-anchor="middle" font-size="13" font-weight="700" letter-spacing="1" fill="#25242a">{node.phase.name}</text>
            </a>
          ))}
          <text x={center} y={center - 4} text-anchor="middle" font-family="Georgia, serif" font-size="22" fill="#25242a">One cycle,</text>
          <text x={center} y={center + 24} text-anchor="middle" font-family="Georgia, serif" font-size="22" fill="#25242a">repeated.</text>
        </svg>
      </div>

      <div class="process-list">
        {cycle.map((phase, index) => {
          const projects = venturesInPhase(phase);
          const next = cycle[(index + 1) % cycle.length];
          return (
            <article class="stage" id={phase.id}>
              <span class="number">{String(index + 1).padStart(2, "0")}</span>
              <div class="stage-content">
                <p class="subtitle">{phase.purpose}</p>
                <h3>{phase.name}</h3>
                <p class="description">{phase.summary}</p>
                <ul class="tasks">
                  {phase.tasks.map((task) => <li>{task}</li>)}
                </ul>
                <dl class="stage-facts">
                  <div>
                    <dt>Done when</dt>
                    <dd>{phase.doneWhen}</dd>
                  </div>
                  <div>
                    <dt>Hands to {next.name}</dt>
                    <dd>{phase.handsOff}</dd>
                  </div>
                  <div>
                    <dt>Projects here now</dt>
                    <dd>
                      {projects.length > 0
                        ? projects.map((venture, position) => (
                            <>{position > 0 && ", "}<a href={`/ventures#${ventureSlug(venture)}`}>{venture.name}</a></>
                          ))
                        : "None yet."}
                    </dd>
                  </div>
                </dl>
              </div>
              <span class="arrow" aria-hidden="true">{index === cycle.length - 1 ? "↺" : "↓"}</span>
            </article>
          );
        })}
      </div>
    </section>

    <section class="experiment">
      <p class="eyebrow">03 / CONTINUOUS DISCOVERY</p>
      <h2>Progress doesn't<br />always move in a straight line<span>.</span></h2>
      <p>
        Some ideas become products. Some experiments lead to entirely
        different questions. Some directions change along the way.
        We see these outcomes as part of the process, not as interruptions.
      </p>
      <div class="keywords">
        <span>QUESTION</span>
        <span>DISCOVER</span>
        <span>TEST</span>
        <span>LEARN</span>
        <span>REPEAT</span>
      </div>
    </section>

    <section class="closing">
      <h2>Make room<br />for what matters<span>.</span></h2>
      <a href="/ventures">EXPLORE OUR VENTURES ↗</a>
    </section>
  </main>

  <Footer />
</body>
</html>

<style>
  :global(*) {
    box-sizing: border-box;
  }

  :global(body) {
    margin: 0;
    background: #f7f6f2;
    color: #25242a;
    font-family: Arial, Helvetica, sans-serif;
  }

  main {
    max-width: 1200px;
    margin: auto;
    padding: 0 7%;
  }

  .hero {
    padding: 120px 0 100px;
    border-bottom: 1px solid #e6e3dc;
  }

  .eyebrow, .section-label {
    color: #8061c8;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 2px;
  }

  h1, h2, h3 {
    font-family: Georgia, serif;
    font-weight: 400;
  }

  h1 {
    font-size: clamp(52px, 8vw, 94px);
    line-height: 1.05;
    letter-spacing: -4px;
    margin: 35px 0;
  }

  h1 span, h2 span {
    color: #8061c8;
  }

  .intro {
    max-width: 540px;
    color: #77747c;
    font-size: 16px;
    line-height: 1.9;
  }

  .hero-note {
    margin-top: 65px;
    color: #aaa5ae;
    font-size: 9px;
    letter-spacing: 2px;
  }

  .statement, .process {
    display: grid;
    grid-template-columns: 1fr 2fr;
    gap: 50px;
    padding: 95px 0;
    border-bottom: 1px solid #e6e3dc;
  }

  .section-label {
    padding-top: 10px;
  }

  .statement h2, .experiment h2, .closing h2 {
    font-size: clamp(38px, 5vw, 62px);
    letter-spacing: -2px;
    line-height: 1.16;
    margin: 0 0 30px;
  }

  .statement p:not(.section-label), .experiment p:not(.eyebrow) {
    max-width: 570px;
    color: #77747c;
    font-size: 14px;
    line-height: 1.9;
  }

  .process-list {
    display: flex;
    flex-direction: column;
  }

  .stage {
    display: grid;
    grid-template-columns: 55px 1fr 30px;
    gap: 20px;
    padding: 30px 0;
    border-top: 1px solid #e6e3dc;
    align-items: start;
  }

  .number {
    color: #8061c8;
    font-size: 12px;
    padding-top: 8px;
  }

  .subtitle {
    color: #aaa5ae;
    font-size: 11px;
    margin: 0 0 10px;
  }

  .stage h3 {
    font-size: 32px;
    margin: 0 0 10px;
  }

  .description {
    color: #77747c;
    font-size: 13px;
    line-height: 1.8;
    max-width: 570px;
  }

  .arrow {
    color: #8061c8;
    font-size: 20px;
  }

  .process-side {
    align-self: start;
    position: sticky;
    top: 112px;
  }

  .ring {
    display: block;
    width: 100%;
    max-width: 400px;
    margin-top: 32px;
    font-family: Arial, Helvetica, sans-serif;
  }

  .ring a:hover rect, .ring a:focus-visible rect {
    fill: #e8e1f4;
  }

  .stage {
    scroll-margin-top: 112px;
  }

  .stage h3 {
    letter-spacing: 1px;
  }

  .tasks {
    display: flex;
    flex-wrap: wrap;
    gap: 7px;
    margin: 20px 0 0;
    padding: 0;
    list-style: none;
  }

  .tasks li {
    padding: 6px 10px;
    border: 1px solid #ded9e6;
    border-radius: 3px;
    color: #5f5b66;
    font-size: 11px;
  }

  .stage-facts {
    margin: 22px 0 0;
  }

  .stage-facts div {
    display: grid;
    grid-template-columns: 130px minmax(0, 1fr);
    gap: 14px;
    padding: 10px 0;
    border-top: 1px solid #efece4;
  }

  .stage-facts dt {
    color: #8b8791;
    font-size: 11px;
    line-height: 1.7;
  }

  .stage-facts dd {
    margin: 0;
    color: #4e4b53;
    font-size: 13px;
    line-height: 1.7;
  }

  .stage-facts a {
    color: #6a4eb3;
  }

  .experiment {
    padding: 110px 0;
    border-bottom: 1px solid #e6e3dc;
  }

  .experiment h2 {
    margin: 30px 0;
  }

  .keywords {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
    margin-top: 55px;
  }

  .keywords span {
    border: 1px solid #ded9e6;
    border-radius: 30px;
    padding: 11px 17px;
    color: #8061c8;
    font-size: 9px;
    letter-spacing: 1px;
  }

  .closing {
    padding: 100px 0;
  }

  .closing a {
    color: #8061c8;
    font-size: 10px;
    letter-spacing: 1.5px;
    text-decoration: none;
  }

  @media (max-width: 700px) {
    main {
      padding: 0 6%;
    }

    .hero {
      padding: 80px 0;
    }

    h1 {
      letter-spacing: -2px;
    }

    .statement, .process {
      grid-template-columns: 1fr;
      gap: 30px;
      padding: 65px 0;
    }

    .process-side {
      position: static;
    }

    .closing a {
      display: inline-block;
      padding: 8px 0;
    }

    .ring {
      margin-inline: auto;
    }

    .stage {
      grid-template-columns: 35px minmax(0, 1fr) 20px;
      gap: 12px;
      scroll-margin-top: 130px;
    }

    .stage-facts div {
      grid-template-columns: minmax(0, 1fr);
      gap: 2px;
    }

    .experiment {
      padding: 75px 0;
    }
  }
</style>
