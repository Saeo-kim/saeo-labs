
---

import Header from "../components/Header.astro";
import { getCollection } from "astro:content";
import { courses } from "../data/academy";
import { statusLabel, ventureNumber, ventures, type VentureStatus } from "../data/ventures";

const featuredVentures = ventures.filter((venture) => venture.featured);

const statusOrder: VentureStatus[] = ["Revenue-generating", "Operating", "Testing", "Building", "Exploring"];
const statusCounts = statusOrder
  .map((status) => ({ status, count: ventures.filter((venture) => venture.status === status).length }))
  .filter((item) => item.count > 0);

const coursesInProgress = courses.filter((course) => course.status === "In Progress").length;
const latestArticle = (await getCollection("history"))
  .filter((entry) => entry.data.status === "Published")
  .sort((a, b) => Number(b.data.date) - Number(a.data.date))[0];

const siteLinks = [
  { label: "About", href: "/about", text: `Philosophy, solo operation, and the Academy, with ${coursesInProgress} of ${courses.length} courses in progress.` },
  { label: "Ventures", href: "/ventures", text: `All ${ventures.length} projects, sorted by what is public, in development, or still a concept.` },
  { label: "Approach", href: "/approach", text: "The cycle from Research to Monetize, and back to Research." },
  { label: "History", href: "/history", text: latestArticle ? `The journal. Latest: ${latestArticle.data.title}` : "The journal of ideas, experiments, and operations." },
];
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="SAEO LABS — Exploring ideas, building products, creating opportunities." />
    <meta name="theme-color" content="#f7f7f5" />
    <title>SAEO LABS — Ideas into reality</title>
  
    <meta name="google-site-verification" content="SMX3puj55xmTtAK85BnJEVyWLrRLZyAeenbFetRjiGw" />
  </head>

  <body>
    
      <Header active="home" />

    <main>
      <section class="hero">
        <div class="eyebrow">
          <span class="dot"></span>
          SAEO LABS — INDEPENDENT VENTURE STUDIO
        </div>

        <h1>
          Ideas are<br />
          only the <span>beginning.</span>
        </h1>

        <p class="hero-motto">Explore. Experiment. Build. Operate.</p>

        <div class="hero-bottom">
          <p>
            We explore interests, develop ideas, and build
            digital products that create new possibilities.
          </p>
          <a href="#about" class="text-link">DISCOVER SAEO LABS ↘</a>
        </div>

        <div class="hero-index">EST. 2026 · INDEPENDENTLY BUILT</div>
      </section>

      <section class="intro" id="about">
        <div class="section-label">01 / ABOUT</div>
        <div class="intro-content">
          <p class="small-heading">INDEPENDENT, NOT ISOLATED.</p>
          <h2>
            Curiosity leads to ideas.<br />
            Ideas lead to <span>possibilities.</span>
          </h2>
          <p class="body-copy">
            SAEO LABS is an independent venture studio exploring
            different fields of interest and developing them
            into meaningful projects, products, and opportunities.
            We decide and answer for the work ourselves, and stay
            connected to the knowledge, tools, and people that make it better.
          </p>
          <a href="/about" class="text-link">READ OUR PHILOSOPHY ↗</a>
        </div>
      </section>

      <section class="ventures" id="ventures">
        <div class="section-top">
          <div>
            <div class="section-label">02 / VENTURES</div>
            <h2>What we're building<span>.</span></h2>
          </div>
          <p>Ideas in progress.<br />Products taking shape.</p>
        </div>

        <div class="venture-list">
          {featuredVentures.map((venture) => (
            <article class="venture-card">
              <span class="venture-number">{ventureNumber(venture)}</span>
              <img
                class="venture-thumb"
                src={venture.preview.src}
                alt={venture.preview.alt}
                width={venture.preview.width}
                height={venture.preview.height}
                loading="lazy"
                decoding="async"
              />
              <div class="venture-info">
                <span class="category">{venture.category}</span>
                <h3>{venture.name}</h3>
                {venture.subtitle && <span class="venture-subtitle">{venture.subtitle}</span>}
                <p>{venture.description}</p>
              </div>
              <div class="venture-action">
                <span class="status">{statusLabel(venture)}</span>
                {venture.link && (
                  <a href={venture.link} target="_blank" rel="noopener noreferrer" aria-label={`Explore ${venture.name}`}>↗</a>
                )}
              </div>
            </article>
          ))}
        </div>

        <a class="ventures-all" href="/ventures">VIEW ALL {ventures.length} VENTURES ↗</a>
      </section>

      <section class="approach" id="approach">
        <div class="section-label">03 / OUR APPROACH</div>
        <h2>Explore. Experiment. Build. <span>Operate.</span></h2>
        <div class="steps">
          <div><span>01</span><h3>Explore</h3><p>Discover interests and identify opportunities.</p></div>
          <div><span>02</span><h3>Experiment</h3><p>Research ideas and test possibilities.</p></div>
          <div><span>03</span><h3>Build</h3><p>Turn promising ideas into real products.</p></div>
          <div><span>04</span><h3>Operate</h3><p>Run what works, and make it sustainable.</p></div>
        </div>
        <a href="/approach" class="ventures-all">SEE THE OPERATING CYCLE ↗</a>
      </section>

      <section class="now" id="now">
        <div class="section-label">04 / NOW</div>
        <h2>Where things <span>stand.</span></h2>
        <ul class="now-stats">
          {statusCounts.map((item) => (
            <li><strong>{item.count}</strong><span>{item.status}</span></li>
          ))}
        </ul>
        <div class="steps">
          {siteLinks.map((link) => (
            <a href={link.href}>
              <h3>{link.label} <span>↗</span></h3>
              <p>{link.text}</p>
            </a>
          ))}
        </div>
      </section>

      <section class="contact" id="contact">
        <div class="section-label">05 / CONTACT</div>
        <h2>Have an idea?<br /><span>Let's explore it.</span></h2>
        <p>New ideas begin with a conversation.</p>
        <a href="mailto:hello@saeolabs.com" class="contact-link">
          GET IN TOUCH ↗
        </a>
        <small>Note: Contact email to be configured.</small>
      </section>
    </main>

    <footer>
      <a class="logo" href="/">SAEO LABS<span>®</span></a>
      <p>INDEPENDENT IDEAS. DIGITAL POSSIBILITIES.</p>
      <span>© 2026 SAEO LABS</span>
    </footer>
  </body>
</html>

<style>
  @import url('https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Manrope:wght@400;500;600;700;800&display=swap');

  :global(*) {
    box-sizing: border-box;
  }

  :global(html) {
    scroll-behavior: smooth;
  }

  :global(body) {
    margin: 0;
    background: #f7f7f5;
    color: #171717;
    font-family: 'DM Sans', sans-serif;
  }

  :global(a) {
    color: inherit;
    text-decoration: none;
  }

  .header {
    height: 82px;
    padding: 0 7%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    border-bottom: 1px solid #e8e8e5;
    position: sticky;
    top: 0;
    background: rgba(247,247,245,.94);
    backdrop-filter: blur(12px);
    z-index: 10;
  }

  .logo {
    font-family: 'Manrope', sans-serif;
    font-size: 20px;
    font-weight: 800;
    letter-spacing: -1px;
  }

  .logo span {
    font-size: 9px;
    vertical-align: top;
    margin-left: 3px;
  }

  nav {
    display: flex;
    gap: 32px;
  }

  nav a, .header-link, .section-label, .eyebrow,
  .hero-index, .category, .status, .venture-number,
  footer p, footer > span {
    font-size: 10px;
    letter-spacing: 1.2px;
    font-weight: 600;
  }

  nav a {
    color: #666;
  }

  nav a:hover, .header-link:hover {
    color: #9b7bce;
  }

  .header-link {
    border: 1px solid #d8d8d3;
    padding: 12px 17px;
    border-radius: 3px;
  }

  .hero {
    min-height: 660px;
    padding: 150px 12% 65px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    border-bottom: 1px solid #e8e8e5;
    position: relative;
  }

  .eyebrow {
    display: flex;
    align-items: center;
    gap: 10px;
    color: #777;
  }

  .dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #a58acb;
  }

  h1, h2, h3, p {
    margin-top: 0;
  }

  .hero h1 {
    font-family: 'Manrope', sans-serif;
    font-size: clamp(60px, 9vw, 116px);
    line-height: 1.05;
    letter-spacing: -7px;
    margin: 35px 0;
    font-weight: 600;
  }

  .hero h1 span, h2 span {
    color: #9b7bce;
  }

  .hero-motto {
    margin-bottom: 30px;
    font-family: 'Manrope', sans-serif;
    font-size: clamp(16px, 2vw, 20px);
    font-weight: 600;
    letter-spacing: -.3px;
  }

  .hero-bottom {
    display: flex;
    justify-content: space-between;
    align-items: end;
    max-width: 850px;
  }

  .hero-bottom p, .body-copy {
    color: #777;
    line-height: 1.9;
    font-size: 14px;
    max-width: 390px;
  }

  .text-link {
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 1px;
    border-bottom: 1px solid #aaa;
    padding-bottom: 8px;
  }

  .hero-index {
    position: absolute;
    right: 7%;
    bottom: 30px;
    color: #aaa;
  }

  .intro, .ventures, .approach, .now, .contact {
    padding: 115px 12%;
    border-bottom: 1px solid #e8e8e5;
  }

  .section-label {
    color: #999;
  }

  .intro-content {
    margin: 65px 0 0 20%;
  }

  .small-heading {
    font-size: 10px;
    letter-spacing: 1.5px;
    color: #9b7bce;
    font-weight: 700;
  }

  .intro h2, .section-top h2, .approach h2, .now h2, .contact h2 {
    font-family: 'Manrope', sans-serif;
    font-size: clamp(34px, 5vw, 58px);
    letter-spacing: -2.5px;
    line-height: 1.2;
    font-weight: 600;
  }

  .body-copy {
    margin-top: 28px;
  }

  .section-top {
    display: flex;
    justify-content: space-between;
    align-items: end;
    margin-bottom: 55px;
  }

  .section-top h2 {
    margin: 24px 0 0;
  }

  .section-top > p {
    color: #888;
    font-size: 12px;
    line-height: 1.8;
  }

  .venture-card {
    padding: 32px 0;
    border-top: 1px solid #deded9;
    display: grid;
    grid-template-columns: 60px 176px 1fr 180px;
    gap: 25px;
    align-items: center;
  }

  .venture-number, .category {
    color: #999;
  }

  .category {
    font-size: 9px;
  }

  .venture-info h3 {
    font-family: 'Manrope', sans-serif;
    font-size: 27px;
    margin: 10px 0;
    letter-spacing: -1px;
  }

  .venture-info p {
    font-size: 12px;
    color: #888;
    line-height: 1.7;
    max-width: 470px;
    margin-bottom: 0;
  }

  .venture-action {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .status {
    color: #9b7bce;
    font-size: 9px;
  }

  .venture-action a {
    border: 1px solid #ddd;
    border-radius: 50%;
    width: 38px;
    height: 38px;
    display: grid;
    place-items: center;
  }

  .venture-thumb {
    display: block;
    width: 100%;
    height: auto;
    border: 1px solid #deded9;
    border-radius: 4px;
  }

  .venture-subtitle {
    display: block;
    margin-bottom: 8px;
    color: #9b7bce;
    font-size: 11px;
  }

  .ventures-all {
    display: inline-block;
    margin-top: 34px;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 1px;
    border-bottom: 1px solid #aaa;
    padding-bottom: 8px;
  }

  .approach {
    background: #efeee9;
  }

  .approach h2, .now h2 {
    margin: 55px 0;
  }

  .now h2 {
    margin-bottom: 36px;
  }

  .now-stats {
    display: flex;
    flex-wrap: wrap;
    gap: 16px 44px;
    margin: 0 0 56px;
    padding: 0;
    list-style: none;
  }

  .now-stats li {
    display: flex;
    align-items: baseline;
    gap: 9px;
  }

  .now-stats strong {
    font-family: 'Manrope', sans-serif;
    font-size: 34px;
    font-weight: 600;
    letter-spacing: -1px;
  }

  .now-stats span {
    color: #666;
    font-size: 12px;
  }

  .steps {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 40px;
  }

  .steps > div, .steps > a {
    border-top: 1px solid #d5d3cd;
    padding-top: 20px;
  }

  .steps > a:hover h3 {
    color: #9b7bce;
  }

  .steps span {
    color: #9b7bce;
    font-size: 11px;
  }

  .steps h3 {
    font-family: 'Manrope', sans-serif;
    font-size: 22px;
    margin: 25px 0 12px;
  }

  .steps p, .contact > p {
    font-size: 12px;
    color: #888;
    line-height: 1.8;
  }

  .contact h2 {
    margin: 55px 0 20px;
  }

  .contact-link {
    display: inline-block;
    margin-top: 25px;
    font-size: 11px;
    letter-spacing: 1px;
    font-weight: 700;
    border-bottom: 1px solid #aaa;
    padding-bottom: 10px;
  }

  .contact small {
    display: block;
    margin-top: 14px;
    color: #aaa;
    font-size: 10px;
  }

  footer {
    min-height: 110px;
    padding: 30px 7%;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  footer p, footer > span {
    color: #999;
    font-size: 9px;
  }

  @media (max-width: 1000px) {
    .venture-card {
      grid-template-columns: 60px 176px 1fr;
      row-gap: 14px;
    }

    .venture-number, .venture-thumb {
      grid-row: 1 / span 2;
    }

    .venture-info, .venture-action {
      grid-column: 3;
    }

    .steps {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 700px) {
    .header {
      padding: 0 5%;
      height: 70px;
    }

    nav {
      gap: 12px;
    }

    nav a {
      font-size: 8px;
    }

    .header-link {
      display: none;
    }

    .hero {
      min-height: 570px;
      padding: 100px 7% 70px;
    }

    .hero h1 {
      font-size: clamp(53px, 12vw, 78px);
      letter-spacing: -4px;
    }

    .text-link, .ventures-all {
      padding-top: 5px;
    }

    footer .logo {
      padding: 2px 0;
    }

    .hero-bottom, .section-top {
      align-items: start;
      flex-direction: column;
      gap: 20px;
    }

    .intro, .ventures, .approach, .now, .contact {
      padding: 85px 7%;
    }

    .intro-content {
      margin: 55px 0 0;
    }

    .venture-card {
      grid-template-columns: 30px 1fr;
      gap: 15px;
    }

    .venture-action {
      grid-column: 2;
    }

    .venture-thumb, .venture-info {
      grid-column: 2;
    }

    .steps {
      grid-template-columns: 1fr;
      gap: 30px;
    }

    footer {
      padding: 28px 5%;
      flex-wrap: wrap;
      gap: 18px;
    }
  }
</style>
