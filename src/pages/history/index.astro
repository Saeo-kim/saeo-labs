---
import { getCollection } from "astro:content";
import Footer from "../../components/Footer.astro";
import Header from "../../components/Header.astro";
import StatusBadge from "../../components/StatusBadge.astro";

const entries = (await getCollection("history")).sort((a, b) => a.data.order - b.data.order);
const published = entries
  .filter((entry) => entry.data.status === "Published")
  .sort((a, b) => Number(b.data.date) - Number(a.data.date));
const inPreparation = entries.filter((entry) => entry.data.status !== "Published");
const lead = published[0];

const longDate = new Intl.DateTimeFormat("en-US", { dateStyle: "long", timeZone: "UTC" });
const shortDate = new Intl.DateTimeFormat("en-US", { year: "numeric", month: "short", day: "2-digit", timeZone: "UTC" });

const opening = (lead?.body ?? "")
  .split(/\r?\n\s*\r?\n/)
  .map((block) => block.trim())
  .filter((block) => block && !block.startsWith("#"))
  .slice(0, 2);
---

<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>History — SAEO LABS</title>
  <meta name="description" content="The SAEO LABS journal and research archive: thinking, experiments, learning, and the experience of running an independent venture studio." />
</head>
<body>
  <Header active="history" />

  <main>
    <header class="masthead">
      <div class="ears">
        <span>EDITORIAL JOURNAL</span>
        <span>RESEARCH ARCHIVE</span>
      </div>
      <h1>History</h1>
      <p class="motto">The written record of SAEO LABS: what we think, test, learn, and run.</p>
      <div class="dateline">
        <span>{lead && `Latest edition: ${longDate.format(lead.data.date)}`}</span>
        <span class="dateline-center">Independent, Not Isolated.</span>
        <span>{published.length} published · {inPreparation.length} in preparation</span>
      </div>
    </header>

    <div class="front">
      <div class="front-main">
      {lead && (
        <article class="lead">
          <p class="kicker">{lead.data.category}</p>
          <h2><a href={`/history/${lead.id}`}>{lead.data.title}</a></h2>
          <p class="deck">{lead.data.summary}</p>
          <p class="byline">By SAEO LABS · {longDate.format(lead.data.date)}</p>
          <div class="columns">
            {opening.map((paragraph) => <p>{paragraph}</p>)}
          </div>
          <a class="continue" href={`/history/${lead.id}`}>CONTINUE READING →</a>
        </article>
      )}

      <section class="archive" aria-labelledby="archive-heading">
        <h2 id="archive-heading">The archive</h2>
        <ol>
          {entries.map((entry) => (
            <li class="row">
              <span class="row-date">{entry.data.date ? shortDate.format(entry.data.date) : "Undated"}</span>
              <span class="row-title">
                {entry.data.status === "Published"
                  ? <a href={`/history/${entry.id}`}>{entry.data.title}</a>
                  : entry.data.title}
              </span>
              <span class="row-category">{entry.data.category}</span>
              <span class="row-status"><StatusBadge status={entry.data.status} /></span>
            </li>
          ))}
        </ol>
      </section>
      </div>

      <aside class="rail" aria-labelledby="rail-heading">
        <h2 id="rail-heading">In preparation</h2>
        <p class="rail-note">Listed so the direction is visible. These are not written yet.</p>
        <ol>
          {inPreparation.map((entry) => (
            <li>
              <p class="kicker">{entry.data.category}</p>
              <h3>{entry.data.title}</h3>
              <p>{entry.data.summary}</p>
              <StatusBadge status={entry.data.status} />
            </li>
          ))}
        </ol>
      </aside>
    </div>
  </main>

  <Footer />
</body>
</html>

<style>
  :global(*) {
    box-sizing: border-box;
  }

  :global(body) {
    margin: 0;
    background: #f3efe5;
    color: #25242a;
    font-family: Georgia, "Times New Roman", serif;
  }

  main {
    max-width: 1200px;
    margin: auto;
    padding: 0 7% 90px;
  }

  .masthead {
    padding-top: 42px;
    text-align: center;
  }

  .ears, .dateline, .kicker, .byline, .continue {
    font-family: Arial, Helvetica, sans-serif;
  }

  .ears {
    display: flex;
    justify-content: space-between;
    color: #6f6b73;
    font-size: 10px;
    letter-spacing: 2px;
  }

  h1 {
    margin: 14px 0 4px;
    font-size: clamp(64px, 15vw, 188px);
    font-weight: 400;
    line-height: 1;
    letter-spacing: -.035em;
  }

  .motto {
    margin: 0 0 26px;
    color: #5f5b66;
    font-size: clamp(15px, 1.8vw, 19px);
    font-style: italic;
    line-height: 1.5;
  }

  .dateline {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
    gap: 6px 20px;
    padding: 11px 0;
    border-top: 3px double #25242a;
    border-bottom: 1px solid #25242a;
    font-size: 11px;
    letter-spacing: .4px;
    text-align: left;
  }

  .dateline span:last-child {
    text-align: right;
  }

  .dateline-center {
    color: #6a4eb3;
    font-weight: 700;
  }

  .front {
    display: grid;
    grid-template-columns: minmax(0, 8fr) minmax(0, 4fr);
    border-bottom: 3px double #25242a;
  }

  .front-main {
    padding-right: 44px;
    border-right: 1px solid #25242a;
  }

  .lead {
    padding: 44px 0 48px;
  }

  .kicker {
    margin: 0;
    color: #6a4eb3;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 1.6px;
    text-transform: uppercase;
  }

  .lead h2 {
    margin: 14px 0 18px;
    font-size: clamp(38px, 7.4vw, 96px);
    font-weight: 400;
    line-height: 1;
    letter-spacing: -.03em;
  }

  .lead h2 a {
    color: inherit;
    text-decoration: none;
  }

  .lead h2 a:hover {
    color: #6a4eb3;
  }

  .deck {
    max-width: 620px;
    margin: 0 0 16px;
    color: #3f3c44;
    font-size: clamp(18px, 2vw, 23px);
    line-height: 1.4;
  }

  .byline {
    margin: 0 0 26px;
    padding-bottom: 14px;
    border-bottom: 1px solid #cdc7b8;
    color: #6f6b73;
    font-size: 11px;
    letter-spacing: .4px;
  }

  .columns {
    columns: 2;
    column-gap: 34px;
    column-rule: 1px solid #cdc7b8;
  }

  .columns p {
    margin: 0 0 14px;
    font-size: 16px;
    line-height: 1.65;
    hyphens: auto;
  }

  .columns p:first-child::first-letter {
    float: left;
    margin: 6px 8px 0 0;
    color: #6a4eb3;
    font-size: 58px;
    line-height: .8;
  }

  .continue {
    display: inline-block;
    margin-top: 12px;
    padding-bottom: 6px;
    border-bottom: 1px solid #6a4eb3;
    color: #25242a;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 1.2px;
    text-decoration: none;
  }

  .continue:hover {
    color: #6a4eb3;
  }

  .rail {
    padding: 44px 0 44px 32px;
  }

  .rail > h2, .archive > h2 {
    margin: 0;
    padding-bottom: 10px;
    border-bottom: 2px solid #25242a;
    font-size: 26px;
    font-weight: 400;
    letter-spacing: -.5px;
  }

  .rail-note {
    margin: 10px 0 0;
    color: #6f6b73;
    font-size: 13px;
    font-style: italic;
    line-height: 1.5;
  }

  ol {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .rail li {
    padding: 18px 0;
    border-bottom: 1px solid #cdc7b8;
  }

  .rail li:last-child {
    border-bottom: 0;
    padding-bottom: 0;
  }

  .rail h3 {
    margin: 7px 0 6px;
    font-size: 20px;
    font-weight: 400;
    line-height: 1.2;
    letter-spacing: -.3px;
  }

  .rail li > p:not(.kicker) {
    margin: 0 0 10px;
    color: #5f5b66;
    font-size: 14px;
    line-height: 1.5;
  }

  .archive {
    padding-bottom: 44px;
  }

  .row {
    display: grid;
    grid-template-columns: 84px minmax(0, 1fr) 96px 86px;
    gap: 16px;
    align-items: baseline;
    padding: 14px 0;
    border-bottom: 1px solid #cdc7b8;
  }

  .row-date, .row-category {
    color: #6f6b73;
    font-family: Arial, Helvetica, sans-serif;
    font-size: 11px;
  }

  .row-title {
    font-size: 19px;
    line-height: 1.3;
  }

  .row-title a {
    color: #25242a;
    text-decoration-color: #6a4eb3;
    text-underline-offset: 3px;
  }

  .row-title a:hover {
    color: #6a4eb3;
  }

  .row-status {
    justify-self: end;
  }

  @media (max-width: 860px) {
    .front {
      grid-template-columns: minmax(0, 1fr);
    }

    .front-main {
      padding-right: 0;
      border-right: 0;
      border-bottom: 1px solid #25242a;
    }

    .rail {
      padding-left: 0;
    }
  }

  @media (max-width: 620px) {
    main {
      padding: 0 6% 70px;
    }

    .ears {
      gap: 12px;
      font-size: 9px;
      letter-spacing: 1.2px;
    }

    .dateline {
      grid-template-columns: minmax(0, 1fr);
      text-align: center;
    }

    .dateline span:last-child {
      text-align: center;
    }

    .columns {
      columns: 1;
    }

    .continue {
      padding-top: 8px;
    }

    .row-title a {
      display: inline-block;
      padding: 2px 0;
    }

    .row {
      grid-template-columns: minmax(0, 1fr) auto;
      gap: 6px 12px;
    }

    .row-title {
      grid-column: 1 / -1;
      grid-row: 1;
    }

    .row-status {
      grid-column: 2;
      grid-row: 2 / span 2;
      align-self: center;
    }

    .row-date {
      grid-column: 1;
    }

    .row-category {
      grid-column: 1;
    }
  }
</style>
