---
import Header from "../components/Header.astro";

const ventures = [
  {
    number: "01",
    name: "Lingua Space",
    category: "LANGUAGE & LEARNING",
    description: "A personal space to collect words, explore languages, and build a learning archive.",
    status: "LIVE PROJECT",
    image: "/images/ventures/lingua-space.svg",
    imageAlt: "A language learning workspace with vocabulary cards and a personal collection",
    href: "https://liguaspace.onrender.com/",
    action: "VISIT PROJECT",
  },
  {
    number: "02",
    name: "FocusFlow",
    category: "PRODUCTIVITY & WORKFLOW",
    description: "A workspace designed to make projects, tasks, and progress easier to understand.",
    status: "IN DEVELOPMENT",
    image: "/images/ventures/focusflow.svg",
    imageAlt: "A minimal project dashboard showing tasks and workflow progress",
    href: "https://github.com/Saeo-kim/freelance-manager",
    action: "VIEW DEVELOPMENT",
  },
  {
    number: "03",
    name: "THE EXPANSION",
    category: "KNOWLEDGE & TECHNOLOGY",
    description: "An expanding map of connected ideas, from the foundations of computing to the systems around us.",
    status: "IN PROGRESS",
    image: "/images/ventures/the-expansion.svg",
    imageAlt: "A network of connected knowledge nodes surrounding the concept of the web",
    href: "https://github.com/Saeo-kim/the-expansion",
    action: "VIEW DEVELOPMENT",
  },
];
---

<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content="Explore independent products and experiments by SAEO LABS." />
  <meta name="theme-color" content="#f7f6f2" />
  <title>Ventures — SAEO LABS</title>
</head>
<body>
  <Header active="ventures" />

  <main>
    <section class="hero">
      <div class="hero-heading">
        <div>
          <p class="eyebrow">SAEO LABS / OUR VENTURES</p>
          <h1>Some of our latest<br />ventures<span>.</span></h1>
        </div>
        <p class="hero-note">Ideas in progress.<br />Products taking shape.</p>
      </div>
      <div class="hero-bottom">
        <span>INDEPENDENT PROJECTS & DIGITAL PRODUCTS</span>
        <span>03 PUBLIC / 01 PRIVATE</span>
      </div>
    </section>

    <section class="portfolio" aria-label="SAEO LABS projects">
      <div class="section-heading">
        <span class="section-label">01 / SELECTED PROJECTS</span>
        <span class="section-note">A closer look at what we're building.</span>
      </div>

      <div class="venture-grid">
        {ventures.map((venture) => (
          <a
            class="venture-card"
            href={venture.href}
            target="_blank"
            rel="noopener noreferrer"
            aria-label={`${venture.name} — ${venture.action}`}
          >
            <div class="image-wrap">
              <img src={venture.image} alt={venture.imageAlt} loading="lazy" />
              <span class="image-number">{venture.number}</span>
              <span class="image-arrow" aria-hidden="true">↗</span>
              <div class="image-caption">
                <span class="card-name">{venture.name}</span>
                <span class="card-category">{venture.category}</span>
              </div>
            </div>
            <div class="card-meta">
              <span class="card-description">{venture.description}</span>
              <span class="card-action">{venture.action} ↗</span>
            </div>
            <span class="status"><i></i>{venture.status}</span>
          </a>
        ))}

        <article class="venture-card private-card" aria-label="Private venture in development">
          <div class="image-wrap">
            <img src="/images/ventures/private-venture.svg" alt="An abstract metallic object representing a private project taking shape" loading="lazy" />
            <span class="image-number">04</span>
            <span class="private-stamp">PRIVATE<br />PROJECT</span>
            <div class="image-caption">
              <span class="card-name">Coming into focus</span>
              <span class="card-category">CONFIDENTIAL / IN DEVELOPMENT</span>
            </div>
          </div>
          <div class="card-meta">
            <span class="card-description">A new direction is taking shape. Details will be shared when the time is right.</span>
            <span class="card-action locked">NOT PUBLIC YET <span aria-hidden="true">↗</span></span>
          </div>
          <span class="status private-status"><i></i>PRIVATE / IN DEVELOPMENT</span>
        </article>
      </div>
    </section>

    <section class="future">
      <p class="eyebrow">WHAT COMES NEXT?</p>
      <h2>One idea can open<br />another <span>direction.</span></h2>
      <p>
        SAEO LABS is a place for continuous exploration.
        Each project is a chance to learn, experiment, and turn
        a new possibility into something real.
      </p>
      <a href="/contact">START A CONVERSATION ↗</a>
    </section>
  </main>

  <footer>
    <a class="footer-logo" href="/">SAEO LABS<span>®</span></a>
    <span>INDEPENDENT IDEAS. DIGITAL POSSIBILITIES.</span>
    <a href="/">BACK TO HOME ↑</a>
  </footer>
</body>
</html>

<style>
  @import url('https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Manrope:wght@400;500;600;700;800&display=swap');

  :global(*) { box-sizing: border-box; }
  :global(html) { scroll-behavior: smooth; }
  :global(body) {
    margin: 0;
    background: #f7f6f2;
    color: #25242a;
    font-family: 'DM Sans', Arial, sans-serif;
  }
  :global(a) { color: inherit; text-decoration: none; }

  main { max-width: 1600px; margin: 0 auto; padding: 0 8%; }

  .hero { padding: 100px 0 28px; }
  .hero-heading {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 30px;
  }
  .eyebrow, .section-label {
    margin: 0;
    color: #8061c8;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 1.8px;
  }
  h1, h2 {
    font-family: 'Manrope', sans-serif;
    font-weight: 500;
    letter-spacing: -4px;
  }
  h1 {
    margin: 28px 0 0;
    font-size: clamp(48px, 7vw, 86px);
    line-height: 1.08;
  }
  h1 span, .future h2 span { color: #8061c8; }
  .hero-note {
    margin: 0 0 8px;
    color: #77747c;
    font-size: 13px;
    line-height: 1.8;
    text-align: right;
  }
  .hero-bottom {
    display: flex;
    justify-content: space-between;
    gap: 20px;
    margin-top: 70px;
    padding: 17px 0;
    border-bottom: 1px solid #dcd8d0;
    color: #aaa5ae;
    font-size: 9px;
    letter-spacing: 1.5px;
  }

  .portfolio { padding: 45px 0 110px; }
  .section-heading {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 24px;
  }
  .section-note { color: #99949c; font-size: 11px; }
  .venture-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 34px 12px;
  }
  .venture-card { display: block; min-width: 0; }
  .image-wrap {
    position: relative;
    overflow: hidden;
    aspect-ratio: 1.48 / 1;
    background: #e5e1dc;
    isolation: isolate;
  }
  .image-wrap::after {
    content: "";
    position: absolute;
    inset: 35% 0 0;
    z-index: 1;
    background: linear-gradient(transparent, rgba(24, 22, 27, .58));
    pointer-events: none;
  }
  .image-wrap img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform .65s cubic-bezier(.2,.7,.2,1), filter .4s ease;
  }
  .venture-card:hover .image-wrap img { transform: scale(1.045); }
  .image-number {
    position: absolute;
    z-index: 2;
    top: 19px;
    left: 20px;
    color: rgba(255,255,255,.85);
    font-size: 10px;
    letter-spacing: 1px;
  }
  .image-arrow {
    position: absolute;
    z-index: 2;
    top: 15px;
    right: 18px;
    display: grid;
    width: 34px;
    height: 34px;
    place-items: center;
    border: 1px solid rgba(255,255,255,.65);
    border-radius: 50%;
    color: white;
    font-size: 17px;
    opacity: 0;
    transform: translate(-5px, 5px);
    transition: opacity .25s ease, transform .25s ease;
  }
  .venture-card:hover .image-arrow { opacity: 1; transform: translate(0,0); }
  .image-caption {
    position: absolute;
    z-index: 2;
    right: 24px;
    bottom: 22px;
    left: 24px;
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 12px;
    color: white;
  }
  .card-name {
    font-family: 'Manrope', sans-serif;
    font-size: clamp(21px, 2.6vw, 32px);
    font-weight: 500;
    letter-spacing: -1.2px;
  }
  .card-category {
    max-width: 45%;
    color: rgba(255,255,255,.78);
    font-size: 8px;
    line-height: 1.5;
    letter-spacing: 1.2px;
    text-align: right;
  }
  .card-meta {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 18px;
    padding: 17px 2px 13px;
  }
  .card-description {
    max-width: 65%;
    color: #77747c;
    font-size: 11px;
    line-height: 1.8;
  }
  .card-action {
    flex-shrink: 0;
    color: #8061c8;
    font-size: 8px;
    font-weight: 700;
    letter-spacing: 1px;
    white-space: nowrap;
  }
  .status {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: #99949c;
    font-size: 8px;
    letter-spacing: 1.2px;
  }
  .status i {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #9b7bce;
  }
  .private-card { cursor: default; }
  .private-card .image-wrap img { filter: saturate(.72); }
  .private-card:hover .image-wrap img { transform: none; }
  .private-stamp {
    position: absolute;
    z-index: 2;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%) rotate(-8deg);
    padding: 13px 23px;
    border: 1px solid rgba(255,255,255,.8);
    color: white;
    font-size: 11px;
    line-height: 1.7;
    letter-spacing: 3px;
    text-align: center;
  }
  .locked { color: #aaa5ae; }
  .private-status i { background: #aaa5ae; }

  .future {
    padding: 100px 0 120px;
    border-top: 1px solid #e6e3dc;
  }
  .future h2 {
    margin: 30px 0;
    font-size: clamp(43px, 6vw, 72px);
    line-height: 1.15;
  }
  .future p:not(.eyebrow) {
    max-width: 530px;
    margin-bottom: 32px;
    color: #77747c;
    font-size: 13px;
    line-height: 1.9;
  }
  .future > a {
    display: inline-block;
    padding-bottom: 8px;
    border-bottom: 1px solid #8061c8;
    font-size: 9px;
    font-weight: 700;
    letter-spacing: 1.3px;
  }
  footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 20px;
    padding: 30px 8%;
    border-top: 1px solid #e6e3dc;
    color: #aaa5ae;
    font-size: 9px;
    letter-spacing: 1px;
  }
  .footer-logo { color: #25242a; font-size: 15px; font-weight: 800; letter-spacing: -.7px; }
  .footer-logo span { color: #8061c8; font-size: 8px; vertical-align: top; }

  @media (max-width: 700px) {
    main { padding: 0 6%; }
    .hero { padding: 75px 0 20px; }
    .hero-heading { align-items: flex-start; flex-direction: column; }
    h1 { letter-spacing: -2.5px; }
    .hero-note { text-align: left; }
    .hero-bottom { margin-top: 48px; font-size: 8px; }
    .portfolio { padding: 35px 0 75px; }
    .section-heading { align-items: flex-start; flex-direction: column; gap: 10px; }
    .venture-grid { grid-template-columns: 1fr; gap: 30px; }
    .image-wrap { aspect-ratio: 1.35 / 1; }
    .card-name { font-size: 26px; }
    .card-category { font-size: 7px; }
    .future { padding: 75px 0 85px; }
    footer { align-items: flex-start; flex-direction: column; padding: 28px 6%; gap: 13px; }
  }

  @media (prefers-reduced-motion: reduce) {
    :global(html) { scroll-behavior: auto; }
    .image-wrap img, .image-arrow { transition: none; }
  }
</style>
