
---
const ventures = [
  {
    number: "01",
    category: "LANGUAGE / LEARNING",
    name: "Lingua Space",
    description: "A space to collect words, explore languages, and build your own learning archive.",
    status: "ACTIVE PROJECT",
    link: "https://liguaspace.onrender.com/",
    linkText: "VISIT PROJECT"
  },
  {
    number: "02",
    category: "PRODUCTIVITY / MANAGEMENT",
    name: "FocusFlow",
    description: "A workspace designed to make projects, tasks, and progress easier to understand.",
    status: "IN DEVELOPMENT",
    link: "#",
    linkText: "COMING SOON"
  },
  {
    number: "03",
    category: "KNOWLEDGE / TECHNOLOGY",
    name: "Knowledge Project",
    description: "An expanding knowledge project exploring development, computing, information, and the world built around technology.",
    status: "EARLY EXPLORATION",
    link: "#",
    linkText: "IN EXPLORATION"
  }
];
---

<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Ventures — SAEO LABS</title>
  <meta name="description" content="Explore products and independent projects developed by SAEO LABS." />
</head>
<body>
  <header>
    <a class="logo" href="/">SAEO LABS<span>®</span></a>
    <nav>
      <a href="/about">ABOUT</a>
      <a class="active" href="/ventures">VENTURES</a>
      <a href="/#approach">APPROACH</a>
      <a href="/#contact">CONTACT</a>
    </nav>
  </header>

  <main>
    <section class="hero">
      <p class="eyebrow">SAEO LABS / OUR VENTURES</p>
      <h1>Different ideas.<br />Independent directions<span>.</span></h1>
      <p class="intro">
        We explore different fields and turn ideas into independent
        products, services, and experiments.
      </p>
      <div class="hero-bottom">
        <span>PROJECTS & INITIATIVES</span>
        <span>01 — 03</span>
      </div>
    </section>

    <section class="venture-list">
      {ventures.map((venture) => (
        <article class="venture">
          <div class="venture-top">
            <span class="number">{venture.number}</span>
            <span class="category">{venture.category}</span>
          </div>

          <div class="venture-content">
            <div>
              <h2>{venture.name}</h2>
              <p>{venture.description}</p>
            </div>
            <div class="venture-action">
              <span class="status">{venture.status}</span>
              <a href={venture.link} target={venture.link.startsWith("http") ? "_blank" : undefined} rel={venture.link.startsWith("http") ? "noopener noreferrer" : undefined}>
                {venture.linkText} ↗
              </a>
            </div>
          </div>
        </article>
      ))}
    </section>

    <section class="future">
      <p class="eyebrow">WHAT COMES NEXT?</p>
      <h2>There is always<br />room for another idea<span>.</span></h2>
      <p>
        Our ventures are not limited to one industry or one way of thinking.
        New questions can lead to new projects, and new projects can open
        entirely different directions.
      </p>
      <a href="/#contact">START A CONVERSATION ↗</a>
    </section>
  </main>

  <footer>
    <span>SAEO LABS © 2026</span>
    <a href="/">BACK TO HOME ↑</a>
  </footer>
</body>
</html>

<style>
  :global(*) {
    box-sizing: border-box;
  }

  :global(body) {
    margin: 0;
    background: #f7f6f2;
    color: #25242a;
    font-family: Arial, Helvetica, sans-serif;
  }

  header {
    height: 82px;
    padding: 0 7%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    border-bottom: 1px solid #e6e3dc;
  }

  .logo {
    font-size: 20px;
    font-weight: 800;
    letter-spacing: -1px;
    color: #25242a;
    text-decoration: none;
  }

  .logo span {
    color: #8061c8;
    font-size: 10px;
    vertical-align: top;
    margin-left: 3px;
  }

  nav {
    display: flex;
    gap: 30px;
  }

  nav a, footer a {
    color: #77747c;
    font-size: 10px;
    letter-spacing: 1.5px;
    text-decoration: none;
  }

  nav a.active, nav a:hover {
    color: #8061c8;
  }

  main {
    max-width: 1200px;
    margin: auto;
    padding: 0 7%;
  }

  .hero {
    padding: 120px 0 55px;
  }

  .eyebrow {
    color: #8061c8;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 2px;
  }

  h1, h2 {
    font-family: Georgia, serif;
    font-weight: 400;
    letter-spacing: -3px;
  }

  h1 {
    font-size: clamp(48px, 8vw, 88px);
    line-height: 1.08;
    margin: 35px 0;
  }

  h1 span, .future h2 span {
    color: #8061c8;
  }

  .intro {
    max-width: 510px;
    color: #77747c;
    font-size: 16px;
    line-height: 1.8;
  }

  .hero-bottom {
    display: flex;
    justify-content: space-between;
    margin-top: 90px;
    padding: 18px 0;
    border-bottom: 1px solid #dcd8d0;
    color: #aaa5ae;
    font-size: 9px;
    letter-spacing: 1.5px;
  }

  .venture {
    padding: 45px 0 50px;
    border-bottom: 1px solid #e6e3dc;
  }

  .venture-top {
    display: flex;
    gap: 22px;
    align-items: center;
  }

  .number {
    color: #8061c8;
    font-size: 12px;
  }

  .category {
    color: #aaa5ae;
    font-size: 9px;
    letter-spacing: 1.5px;
  }

  .venture-content {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 30px;
    margin-top: 30px;
  }

  .venture h2 {
    font-size: clamp(36px, 5vw, 58px);
    margin: 0 0 15px;
  }

  .venture p {
    max-width: 570px;
    color: #77747c;
    font-size: 14px;
    line-height: 1.9;
  }

  .venture-action {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 20px;
    min-width: 150px;
  }

  .status {
    color: #8061c8;
    font-size: 9px;
    letter-spacing: 1px;
  }

  .venture-action a, .future a {
    color: #25242a;
    text-decoration: none;
    font-size: 10px;
    letter-spacing: 1.2px;
    border-bottom: 1px solid #8061c8;
    padding-bottom: 7px;
  }

  .venture-action a:hover, .future a:hover {
    color: #8061c8;
  }

  .future {
    padding: 120px 0;
  }

  .future h2 {
    font-size: clamp(45px, 7vw, 75px);
    line-height: 1.15;
    margin: 30px 0;
  }

  .future p:not(.eyebrow) {
    max-width: 550px;
    color: #77747c;
    font-size: 14px;
    line-height: 1.9;
    margin-bottom: 35px;
  }

  footer {
    border-top: 1px solid #e6e3dc;
    padding: 30px 7%;
    display: flex;
    justify-content: space-between;
    color: #aaa5ae;
    font-size: 10px;
    letter-spacing: 1px;
  }

  @media (max-width: 700px) {
    header {
      height: auto;
      min-height: 75px;
      align-items: flex-start;
      flex-direction: column;
      justify-content: center;
      gap: 16px;
      padding: 18px 6%;
    }

    nav {
      gap: 17px;
      flex-wrap: wrap;
    }

    main {
      padding: 0 6%;
    }

    .hero {
      padding: 80px 0 40px;
    }

    h1 {
      letter-spacing: -2px;
    }

    .venture-content {
      flex-direction: column;
      align-items: flex-start;
    }

    .venture-action {
      margin-top: 15px;
    }

    .future {
      padding: 80px 0;
    }
  }
</style>
