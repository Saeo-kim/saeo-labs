
---
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import VentureDetails from "../components/VentureDetails.astro";
import VentureMotif from "../components/VentureMotif.astro";
import { businessCategories, statusLabel, ventureNumber as numberOf, ventureSlug, ventures } from "../data/ventures";

const liveVentures = ventures.filter((venture) => venture.stage === "live");
const buildingVentures = ventures.filter((venture) => venture.stage === "development" && venture.status !== "Exploring");
const conceptVentures = ventures.filter((venture) => venture.status === "Exploring");
const labBands = [
  { id: "lab-heading", eyebrow: "UPCOMING VENTURES", title: "In development", note: "Being built now and not yet open to the public. Screens shown are real.", items: buildingVentures },
  { id: "concept-heading", eyebrow: "EARLY IDEAS", title: "Concept stage", note: "Ideas still being explored. None is available to use yet, and the visuals are illustrations, not product screens.", items: conceptVentures },
];
const areaGroups = businessCategories.map((area) => ({
  ...area,
  primary: ventures.filter((venture) => venture.businessAreas[0] === area.name),
  related: ventures.filter((venture) => venture.businessAreas.slice(1).includes(area.name)),
}));
---

<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Ventures — SAEO LABS</title>
  <meta name="description" content="Explore products and independent projects developed by SAEO LABS." />
</head>
<body>
  <Header active="ventures" />

  <main>
    <section class="hero">
      <p class="eyebrow">SAEO LABS / OUR VENTURES</p>
      <h1>Different ideas.<br />Independent directions<span>.</span></h1>
      <p class="intro">
        We explore different fields and turn ideas into independent
        products, services, and experiments.
      </p>
      <div class="hero-bottom">
        <span>PROJECTS & INITIATIVES</span>
        <span>01 — {String(ventures.length).padStart(2, "0")}</span>
      </div>
    </section>

    <section class="portfolio" aria-labelledby="live-heading">
      <div class="band-head">
        <p class="eyebrow">OPEN NOW</p>
        <h2 id="live-heading">Live ventures<span>.</span></h2>
      </div>

      {liveVentures.map((venture, index) => (
        <article id={ventureSlug(venture)} class:list={["project", { "project--mirror": index % 2 === 1 }]}>
          <div class="project-top">
            <span class="number">{numberOf(venture)}</span>
            <span class="category">{venture.category}</span>
          </div>

          <div class="project-body">
            <a class="shot" href={venture.link} target="_blank" rel="noopener noreferrer">
              <span class="shot-bar" aria-hidden="true">
                <i></i><i></i><i></i>
                <span class="shot-host">{new URL(venture.link).host}</span>
              </span>
              <img
                src={venture.preview.src}
                alt={venture.preview.alt}
                width={venture.preview.width}
                height={venture.preview.height}
                loading="lazy"
                decoding="async"
              />
            </a>

            <div class="project-copy">
              {venture.icon && (
                <img class="project-icon" src={venture.icon} alt="" width="56" height="56" loading="lazy" decoding="async" />
              )}
              <h3>{venture.name}</h3>
              <p>{venture.description}</p>
              <div class="project-action">
                <span class="status status--live"><i aria-hidden="true"></i>{statusLabel(venture)}</span>
                <a href={venture.link} target="_blank" rel="noopener noreferrer">VISIT PROJECT ↗</a>
              </div>
              <VentureDetails venture={venture} />
            </div>
          </div>
        </article>
      ))}
    </section>

    <section class="lab" aria-labelledby="lab-heading">
      {labBands.map((band) => (
      <div class="lab-band">
      <div class="band-head">
        <p class="eyebrow">{band.eyebrow}</p>
        <h2 id={band.id}>{band.title}<span>.</span></h2>
        <p class="band-note">{band.note}</p>
      </div>

      <div class="lab-grid">
        {band.items.map((venture) => (
          <article id={ventureSlug(venture)} class:list={["lab-card", `span-${venture.span}`]}>
            <div class="lab-visual">
              {venture.preview ? (
                <>
                  <span class="screen-tag">PRODUCT SCREEN</span>
                  <img
                    src={venture.preview.src}
                    alt={venture.preview.alt}
                    width={venture.preview.width}
                    height={venture.preview.height}
                    loading="lazy"
                    decoding="async"
                  />
                </>
              ) : (
                <VentureMotif kind={venture.motif} />
              )}
            </div>

            <div class="lab-meta">
              <span class="number">{numberOf(venture)}</span>
              <span class="category">{venture.category}</span>
            </div>
            <h3>{venture.name}</h3>
            {venture.subtitle && <p class="lab-subtitle">{venture.subtitle}</p>}
            <p>{venture.description}</p>
            <div class="lab-foot">
              <span class="status status--dev">{statusLabel(venture)}</span>
              {venture.link && (
                <a href={venture.link} target="_blank" rel="noopener noreferrer">VISIT PROJECT ↗</a>
              )}
            </div>
            <VentureDetails venture={venture} />
          </article>
        ))}
      </div>
      </div>
      ))}
    </section>

    <section class="areas" aria-labelledby="areas-heading">
      <div class="band-head">
        <p class="eyebrow">BUSINESS AREAS</p>
        <h2 id="areas-heading">Five fields of work<span>.</span></h2>
        <p class="band-note">Each project has one primary area. Some also relate to others.</p>
      </div>

      <div class="area-list">
        {areaGroups.map((area) => (
          <article class="area">
            <h3>{area.name}</h3>
            <p>{area.description}</p>
            <div class="area-projects">
              {area.primary.length > 0 ? area.primary.map((venture) => (
                <a href={`#${ventureSlug(venture)}`}>{venture.name}</a>
              )) : <span class="area-empty">No primary project yet</span>}
              {area.related.map((venture) => (
                <a class="area-related" href={`#${ventureSlug(venture)}`}>{venture.name}</a>
              ))}
            </div>
          </article>
        ))}
      </div>
      <p class="area-key"><span aria-hidden="true">●</span> Primary <span class="area-key-gap" aria-hidden="true">○</span> Related</p>
    </section>

    <section class="future">
      <p class="eyebrow">WHAT COMES NEXT?</p>
      <h2>There is always<br />room for another idea<span>.</span></h2>
      <p>
        Our ventures are not limited to one industry or one way of thinking.
        New questions can lead to new projects, and new projects can open
        entirely different directions.
      </p>
      <a href="/#contact">START A CONVERSATION ↗</a>
    </section>
  </main>

  <Footer />
</body>
</html>

<style>
  :global(*) {
    box-sizing: border-box;
  }

  :global(body) {
    margin: 0;
    background: #f7f6f2;
    color: #25242a;
    font-family: Arial, Helvetica, sans-serif;
  }

  main {
    max-width: 1200px;
    margin: auto;
    padding: 0 7%;
  }

  .hero {
    padding: 120px 0 55px;
  }

  .eyebrow {
    color: #8061c8;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 2px;
  }

  h1, h2, h3 {
    font-family: Georgia, serif;
    font-weight: 400;
    letter-spacing: -3px;
  }

  h1 {
    font-size: clamp(48px, 8vw, 88px);
    line-height: 1.08;
    margin: 35px 0;
  }

  h1 span, .future h2 span, .band-head h2 span {
    color: #8061c8;
  }

  .intro {
    max-width: 510px;
    color: #77747c;
    font-size: 16px;
    line-height: 1.8;
  }

  .hero-bottom {
    display: flex;
    justify-content: space-between;
    margin-top: 90px;
    padding: 18px 0;
    border-bottom: 1px solid #dcd8d0;
    color: #aaa5ae;
    font-size: 9px;
    letter-spacing: 1.5px;
  }

  .band-head {
    margin-bottom: 8px;
  }

  .band-head .eyebrow {
    margin: 0;
  }

  .band-head h2 {
    margin: 16px 0 0;
    font-size: clamp(36px, 5vw, 56px);
    line-height: 1.1;
  }

  .band-note {
    margin: 14px 0 0;
    color: #77747c;
    font-size: 14px;
    line-height: 1.7;
  }

  .portfolio {
    padding-top: 70px;
  }

  .project {
    padding: 60px 0 75px;
    border-bottom: 1px solid #e6e3dc;
  }

  .project:last-child {
    border-bottom: 0;
  }

  .project-top {
    display: flex;
    gap: 22px;
    align-items: center;
    margin-bottom: 32px;
  }

  .number {
    color: #8061c8;
    font-size: 12px;
  }

  .category {
    color: #8b8791;
    font-size: 9px;
    letter-spacing: 1.5px;
  }

  .project-body {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: 24px;
    align-items: end;
    padding-bottom: 44px;
  }

  .project-copy h3 {
    font-size: clamp(36px, 5vw, 58px);
    line-height: 1.08;
    margin: 0 0 15px;
  }

  .project-copy p, .lab-card p {
    color: #77747c;
    font-size: 14px;
    line-height: 1.9;
    margin: 0;
  }

  .project-action {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 16px 28px;
    margin-top: 26px;
  }

  .status {
    font-size: 9px;
    letter-spacing: 1px;
  }

  .status--live {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    color: #2f7a52;
    font-weight: 700;
  }

  .status--live i {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #3fa06c;
  }

  .status--dev {
    display: inline-block;
    padding: 6px 10px;
    border: 1px solid #8061c8;
    border-radius: 3px;
    color: #6a4eb3;
    font-weight: 700;
  }

  .project-action a, .future a, .lab-foot a {
    color: #25242a;
    text-decoration: none;
    font-size: 10px;
    letter-spacing: 1.2px;
    border-bottom: 1px solid #8061c8;
    padding-bottom: 7px;
  }

  .project-action a:hover, .future a:hover, .lab-foot a:hover {
    color: #8061c8;
  }

  .shot {
    grid-column: 1 / 10;
    grid-row: 1;
    display: block;
    overflow: hidden;
    border: 1px solid #dcd8d0;
    border-radius: 8px;
    background: #fff;
    box-shadow: 0 24px 60px -32px rgba(64, 44, 120, .45);
    text-decoration: none;
    transition: transform .25s ease, box-shadow .25s ease;
  }

  .shot:hover {
    transform: translateY(-4px);
    box-shadow: 0 32px 70px -30px rgba(64, 44, 120, .55);
  }

  .shot:focus-visible, .project-action a:focus-visible, .lab-foot a:focus-visible {
    outline: 2px solid #8061c8;
    outline-offset: 3px;
  }

  .shot-bar {
    display: flex;
    align-items: center;
    gap: 6px;
    height: 34px;
    padding: 0 14px;
    border-bottom: 1px solid #e6e3dc;
    background: #f0eee8;
  }

  .shot-bar i {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #d3cfc6;
  }

  .shot-host {
    margin-left: 12px;
    overflow: hidden;
    color: #77747c;
    font-size: 11px;
    white-space: nowrap;
    text-overflow: ellipsis;
  }

  .shot img {
    display: block;
    width: 100%;
    height: auto;
  }

  .project-copy {
    grid-column: 8 / 13;
    grid-row: 1;
    position: relative;
    z-index: 1;
    margin-bottom: -44px;
    padding: 32px;
    border: 1px solid #e6e3dc;
    border-radius: 8px;
    background: #f7f6f2;
  }

  /* Side by side: this screen's headline sits where an overlap would land */
  @media (min-width: 861px) {
    .project--mirror .project-body {
      align-items: center;
      padding-bottom: 0;
    }

    .project--mirror .shot {
      grid-column: 5 / 13;
    }

    .project--mirror .project-copy {
      grid-column: 1 / 5;
      margin-bottom: 0;
      padding: 0;
      border: 0;
      border-radius: 0;
      background: none;
    }

    .project--mirror .project-copy h3 {
      font-size: clamp(32px, 3.6vw, 46px);
      letter-spacing: -2px;
    }
  }

  .project-icon {
    display: block;
    margin-bottom: 18px;
    border-radius: 13px;
  }

  .lab {
    padding: clamp(32px, 5vw, 60px);
    border-radius: 12px;
    background: #efece4;
  }

  .lab .band-head {
    margin-bottom: 42px;
  }

  .lab-band + .lab-band {
    margin-top: 64px;
    padding-top: 56px;
    border-top: 1px solid #dcd8d0;
  }

  .project, .lab-card {
    scroll-margin-top: 130px;
  }

  .areas {
    padding-top: 110px;
  }

  .area-list {
    margin-top: 40px;
  }

  .area {
    display: grid;
    grid-template-columns: minmax(0, 4fr) minmax(0, 4fr) minmax(0, 4fr);
    gap: 10px 24px;
    padding: 24px 0;
    border-top: 1px solid #e6e3dc;
  }

  .area h3 {
    margin: 0;
    font-size: 24px;
    line-height: 1.2;
    letter-spacing: -.8px;
  }

  .area p {
    margin: 0;
    color: #77747c;
    font-size: 13px;
    line-height: 1.7;
  }

  .area-projects {
    display: flex;
    flex-wrap: wrap;
    align-content: flex-start;
    gap: 8px;
  }

  .area-projects a, .area-empty {
    padding: 6px 10px;
    border-radius: 3px;
    font-size: 11px;
    text-decoration: none;
  }

  .area-projects a {
    border: 1px solid #8061c8;
    background: #8061c8;
    color: #fff;
  }

  .area-projects a.area-related {
    background: none;
    color: #6a4eb3;
  }

  .area-projects a:focus-visible {
    outline: 2px solid #8061c8;
    outline-offset: 2px;
  }

  .area-empty {
    color: #77747c;
  }

  .area-key {
    margin: 0;
    padding-top: 16px;
    border-top: 1px solid #e6e3dc;
    color: #77747c;
    font-size: 11px;
  }

  .area-key span:first-child {
    color: #8061c8;
  }

  .area-key-gap {
    margin-left: 14px;
    color: #8061c8;
  }

  .lab-grid {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: 44px 24px;
  }

  .lab-card {
    min-width: 0;
  }

  .span-4 { grid-column: span 4; }
  .span-5 { grid-column: span 5; }
  .span-7 { grid-column: span 7; }

  .lab-visual {
    position: relative;
    height: 250px;
    overflow: hidden;
    border-radius: 8px;
  }

  .lab-visual img {
    display: block;
    width: 100%;
    height: 100%;
    border: 1px solid #dcd8d0;
    border-radius: 8px;
    object-fit: cover;
    object-position: top left;
  }

  .screen-tag {
    position: absolute;
    right: 10px;
    bottom: 10px;
    padding: 5px 8px;
    border-radius: 3px;
    background: #25242a;
    color: #f7f6f2;
    font-size: 8px;
    letter-spacing: 1.4px;
  }

  .lab-card p.lab-subtitle {
    margin-bottom: 6px;
    color: #6a4eb3;
    font-size: 11px;
    letter-spacing: .6px;
  }

  .lab-meta {
    display: flex;
    gap: 14px;
    align-items: center;
    margin-top: 20px;
  }

  .lab-card h3 {
    font-size: clamp(24px, 2.6vw, 32px);
    line-height: 1.15;
    letter-spacing: -1.2px;
    margin: 12px 0 8px;
  }

  .lab-foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 12px 20px;
    margin-top: 16px;
  }

  .future {
    padding: 120px 0;
  }

  .future h2 {
    font-size: clamp(45px, 7vw, 75px);
    line-height: 1.15;
    margin: 30px 0;
  }

  .future p:not(.eyebrow) {
    max-width: 550px;
    color: #77747c;
    font-size: 14px;
    line-height: 1.9;
    margin-bottom: 35px;
  }

  @media (prefers-reduced-motion: reduce) {
    .shot {
      transition: none;
    }

    .shot:hover {
      transform: none;
    }
  }

  @media (max-width: 860px) {
    .project-body {
      display: block;
      padding-bottom: 0;
    }

    .project-copy {
      margin: 24px 0 0;
      padding: 0;
      border: 0;
      border-radius: 0;
      background: none;
    }

    .span-4, .span-5, .span-7 {
      grid-column: span 6;
    }

    .lab-card:last-child:nth-child(odd) {
      grid-column: span 12;
    }

    .area {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  @media (max-width: 700px) {
    main {
      padding: 0 6%;
    }

    .hero {
      padding: 80px 0 40px;
    }

    h1 {
      letter-spacing: -2px;
    }

    .portfolio {
      padding-top: 48px;
    }

    .project {
      padding: 44px 0 56px;
    }

    .project-action a, .future a {
      display: inline-block;
      padding-top: 10px;
    }

    .span-4, .span-5, .span-7, .lab-card:last-child:nth-child(odd) {
      grid-column: 1 / -1;
    }

    .future {
      padding: 80px 0;
    }
  }
</style>
