---
interface Props {
  status: string;
}

const { status } = Astro.props;

const tone =
  status === "Published" || status === "Completed"
    ? "done"
    : status === "In Progress" || status === "Draft"
      ? "active"
      : "idle";
---

<span class:list={["badge", `badge--${tone}`]}>{status.toUpperCase()}</span>

<style>
  .badge {
    display: inline-block;
    padding: 5px 8px;
    border: 1px solid;
    border-radius: 3px;
    font-family: Arial, Helvetica, sans-serif;
    font-size: 9px;
    font-weight: 700;
    letter-spacing: 1px;
    white-space: nowrap;
  }

  .badge--done {
    border-color: #2f7a52;
    color: #2f7a52;
  }

  .badge--active {
    border-color: #8061c8;
    color: #6a4eb3;
  }

  .badge--idle {
    border-color: #cbc6bd;
    color: #6f6b73;
  }
</style>
