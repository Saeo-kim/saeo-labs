---
import type { MotifKind } from "../data/ventures";

interface Props {
  kind: MotifKind;
}

const { kind } = Astro.props;

const vaultTicks = Array.from({ length: 36 }, (_, index) => {
  const angle = (index * Math.PI) / 18;
  const inner = index % 3 === 0 ? 92 : 98;
  return {
    x1: 240 + Math.cos(angle) * inner,
    y1: 135 + Math.sin(angle) * inner,
    x2: 240 + Math.cos(angle) * 106,
    y2: 135 + Math.sin(angle) * 106,
  };
});
---

<div class:list={["motif", `motif-${kind}`]} aria-hidden="true">
  <span class="tag">CONCEPT VISUAL</span>

  <svg viewBox="0 0 480 270" preserveAspectRatio="xMidYMid meet" focusable="false">
    {kind === "flow" && (
      <g>
        <line x1="60" y1="120" x2="420" y2="120" stroke="#5a5663" />
        <circle cx="60" cy="120" r="8" fill="#25242a" stroke="#b9a6e6" stroke-width="2" />
        <circle cx="240" cy="120" r="8" fill="#6f5aa6" stroke="#b9a6e6" stroke-width="2" />
        <circle cx="420" cy="120" r="8" fill="#b9a6e6" stroke="#b9a6e6" stroke-width="2" />
        <text x="44" y="175" class="serif" font-size="30" fill="#f7f6f2">Projects</text>
        <text x="206" y="175" class="serif" font-size="30" fill="#f7f6f2">Tasks</text>
        <text x="340" y="175" class="serif" font-size="30" fill="#f7f6f2">Progress</text>
      </g>
    )}

    {kind === "join" && (
      <g>
        <defs>
          <clipPath id="join-left"><circle cx="190" cy="135" r="92" /></clipPath>
        </defs>
        <circle cx="290" cy="135" r="92" fill="#8061c8" clip-path="url(#join-left)" />
        <circle cx="190" cy="135" r="92" fill="none" stroke="#25242a" stroke-width="1.5" />
        <circle cx="290" cy="135" r="92" fill="none" stroke="#25242a" stroke-width="1.5" />
        <text x="140" y="146" class="serif" font-size="34" fill="#25242a" text-anchor="middle">A</text>
        <text x="340" y="146" class="serif" font-size="34" fill="#25242a" text-anchor="middle">B</text>
        <text x="240" y="141" class="mono" font-size="15" fill="#fff" text-anchor="middle">JOIN</text>
      </g>
    )}

    {kind === "blueprint" && (
      <g fill="none" stroke="#dbe5ff" stroke-width="1.5" stroke-linejoin="round">
        <path d="M240 50 L322 92 L240 134 L158 92 Z" />
        <path d="M158 92 V186 L240 228 V134" />
        <path d="M322 92 V186 L240 228" />
        <path d="M240 134 L240 228" stroke-dasharray="4 5" opacity=".55" />
        <path d="M352 92 V186 M345 92 H359 M345 186 H359" stroke-width="1" />
        <path d="M144 200 L226 242 M140 207 L148 193 M222 249 L230 235" stroke-width="1" />
        <text x="366" y="144" class="mono" font-size="14" fill="#dbe5ff" stroke="none">h</text>
        <text x="166" y="240" class="mono" font-size="14" fill="#dbe5ff" stroke="none">a</text>
      </g>
    )}

    {kind === "vault" && (
      <g>
        {vaultTicks.map((tick) => (
          <line x1={tick.x1} y1={tick.y1} x2={tick.x2} y2={tick.y2} stroke="#25242a" stroke-width="1.4" />
        ))}
        <circle cx="240" cy="135" r="84" fill="#fff" stroke="#25242a" stroke-width="1.5" />
        <circle cx="240" cy="135" r="62" fill="none" stroke="#c8553d" stroke-width="1.5" stroke-dasharray="3 6" />
        <circle cx="240" cy="135" r="42" fill="#c8553d" />
        <text x="240" y="154" class="serif" font-size="54" fill="#fff" text-anchor="middle">!</text>
      </g>
    )}

    {kind === "tower" && (
      <g>
        <g fill="none" stroke="#fff">
          <circle cx="240" cy="72" r="46" opacity=".75" />
          <circle cx="240" cy="72" r="86" opacity=".42" />
          <circle cx="240" cy="72" r="128" opacity=".2" />
          <path d="M240 72 L150 48 M240 72 L333 44 M240 72 L134 132 M240 72 L350 136" stroke-dasharray="2 5" opacity=".7" />
        </g>
        <g fill="#fff">
          <circle cx="150" cy="48" r="6" />
          <circle cx="333" cy="44" r="6" />
          <circle cx="134" cy="132" r="6" />
          <circle cx="350" cy="136" r="6" />
        </g>
        <path d="M240 72 V98" stroke="#fff" stroke-width="2" />
        <path d="M206 98 H274 L265 128 H215 Z" fill="#25242a" />
        <path d="M226 128 H254 L262 262 H218 Z" fill="#25242a" />
      </g>
    )}

    {kind === "radar" && (
      <g fill="none" stroke="#7fe0a8">
        <path d="M240 135 L240 10 A125 125 0 0 1 348 197 Z" fill="#7fe0a8" stroke="none" opacity=".2" />
        <circle cx="240" cy="135" r="125" opacity=".85" />
        <circle cx="240" cy="135" r="84" opacity=".45" />
        <circle cx="240" cy="135" r="42" opacity=".45" />
        <ellipse cx="240" cy="135" rx="62" ry="125" opacity=".35" />
        <path d="M115 135 H365 M240 10 V260" opacity=".35" />
        <path d="M240 135 L348 197" stroke-width="1.5" />
        <g fill="#7fe0a8" stroke="none">
          <circle cx="292" cy="82" r="6" />
          <circle cx="326" cy="146" r="4.5" />
          <circle cx="268" cy="172" r="3.5" />
        </g>
        <circle cx="176" cy="96" r="4" fill="#f7f6f2" stroke="none" opacity=".6" />
      </g>
    )}

    {kind === "playground" && (
      <g>
        <circle cx="130" cy="108" r="60" fill="#e8694a" />
        <path d="M222 188 L290 62 L358 188 Z" fill="#8061c8" />
        <rect x="104" y="172" width="62" height="62" rx="6" transform="rotate(-14 135 203)" fill="#25242a" />
        <path d="M200 232 q24 -34 48 0 t48 0 t48 0" fill="none" stroke="#25242a" stroke-width="7" stroke-linecap="round" />
        <circle cx="388" cy="84" r="20" fill="#fff" />
        <path d="M368 214 a30 30 0 0 1 60 0 Z" fill="#e8694a" />
      </g>
    )}
  </svg>
</div>

<style>
  .motif {
    position: relative;
    width: 100%;
    height: 100%;
    min-height: 250px;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 34px 16px 14px;
    overflow: hidden;
    border-radius: 8px;
  }

  svg {
    display: block;
    width: 100%;
    height: 210px;
  }

  .tag {
    position: absolute;
    top: 16px;
    left: 18px;
    font-size: 8px;
    letter-spacing: 1.4px;
  }

  .serif {
    font-family: Georgia, serif;
    letter-spacing: -1px;
  }

  .mono {
    font-family: "Courier New", monospace;
    letter-spacing: 2px;
  }

  .motif-flow {
    background: #25242a;
    color: #b9a6e6;
  }

  .motif-join {
    background: #e8e1f4;
    color: #5f4a9e;
  }

  .motif-blueprint {
    background-color: #1f2b4a;
    background-image:
      linear-gradient(#33426a 1px, transparent 1px),
      linear-gradient(90deg, #33426a 1px, transparent 1px);
    background-size: 22px 22px;
    color: #dbe5ff;
  }

  .motif-vault {
    background: #f1e6df;
    color: #a3412c;
  }

  .motif-tower {
    background: #8061c8;
    color: #fff;
  }

  .motif-radar {
    background: #12211c;
    color: #7fe0a8;
  }

  .motif-playground {
    background: #f4d68a;
    color: #25242a;
  }
</style>
