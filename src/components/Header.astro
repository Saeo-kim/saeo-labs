
---
interface Props {
  active?: string;
}

const { active = "" } = Astro.props;

const navigation = [
  { label: "HOME", href: "/", key: "home" },
  { label: "ABOUT", href: "/about", key: "about" },
  { label: "VENTURES", href: "/ventures", key: "ventures" },
  { label: "APPROACH", href: "/approach", key: "approach" },
  { label: "HISTORY", href: "/history", key: "history" },
  { label: "CONTACT", href: "/contact", key: "contact" },
];
---

<header class="header">
  <a class="logo" href="/">SAEO LABS<span>®</span></a>

  <nav aria-label="Main">
    {navigation.map((item) => (
      <a
        href={item.href}
        class:list={{ active: active === item.key }}
        aria-current={active === item.key ? "page" : undefined}
      >
        {item.label}
      </a>
    ))}
  </nav>
</header>

<style>
  .header {
  height: 88px;
  padding: 0 8%;
  display: flex;
  align-items: center;
  justify-content: space-between;
  border-bottom: 1px solid #e5e2dc;

  position: sticky;
  top: 0;
  z-index: 1000;

  background: #f7f6f2;
}

  .logo {
    color: #252321;
    text-decoration: none;
    font-size: 17px;
    font-weight: 800;
    letter-spacing: -0.7px;
  }

  .logo span {
    margin-left: 3px;
    color: #8061c8;
    font-size: 9px;
    vertical-align: top;
  }

  nav {
    display: flex;
    gap: clamp(14px, 2.4vw, 32px);
  }

  nav a {
    color: #77736e;
    text-decoration: none;
    font-size: 10px;
    letter-spacing: 1.3px;
  }

  nav a:hover,
  nav a.active {
    color: #8061c8;
  }

  @media (max-width: 650px) {
    .header {
      height: auto;
      min-height: 80px;
      padding: 12px 6%;
      align-items: flex-start;
      gap: 4px;
      flex-direction: column;
    }

    .logo {
      padding: 3px 0;
    }

    nav {
      width: 100%;
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 0 10px;
    }

    nav a {
      padding: 9px 0;
      font-size: 10px;
    }
  }

  /* On short screens a pinned two-row menu would take too much of the view. */
  @media (max-width: 650px) and (max-height: 700px) {
    .header {
      position: static;
    }
  }
</style>
