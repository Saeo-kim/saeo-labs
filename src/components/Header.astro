---
interface Props {
  active?: string;
  variant?: "default" | "editorial";
}

const { active = "", variant = "default" } = Astro.props;

const navigation = [
  { label: "ABOUT", href: "/about", key: "about" },
  { label: "VENTURES", href: "/ventures", key: "ventures" },
  { label: "APPROACH", href: "/approach", key: "approach" },
  { label: "CONTACT", href: "/contact", key: "contact" },
];
---

{variant === "editorial" ? (
  <header class="editorial-header">
    <a href="/contact">WORK WITH US</a>
    <a class="editorial-logo" href="/">SAEO LABS</a>

    <details class="menu">
      <summary>MENU</summary>
      <nav>
        {navigation.map((item) => (
          <a href={item.href}>{item.label}</a>
        ))}
      </nav>
    </details>
  </header>
) : (
  <header class="header">
    <a class="logo" href="/">SAEO LABS<span>®</span></a>

    <nav>
      {navigation.map((item) => (
        <a
          href={item.href}
          class:list={{ active: active === item.key }}
        >
          {item.label}
        </a>
      ))}
    </nav>
  </header>
)}

<style>
  .header {
    height: 88px;
    padding: 0 8%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    border-bottom: 1px solid #e5e2dc;
    position: sticky;
    top: 0;
    z-index: 1000;
    background: #f7f6f2;
  }

  .logo {
    color: #252321;
    text-decoration: none;
    font-size: 17px;
    font-weight: 800;
    letter-spacing: -0.7px;
  }

  .logo span {
    margin-left: 3px;
    color: #8061c8;
    font-size: 9px;
    vertical-align: top;
  }

  nav {
    display: flex;
    gap: 32px;
  }

  .header nav a {
    color: #77736e;
    text-decoration: none;
    font-size: 10px;
    letter-spacing: 1.3px;
  }

  .header nav a:hover,
  .header nav a.active {
    color: #8061c8;
  }

  /* About editorial header */

  .editorial-header {
    height: 40px;
    padding: 0 10px;
    display: grid;
    grid-template-columns: 1fr 1fr 1fr;
    align-items: center;
    border-bottom: 1px solid #999;
    background: white;
    position: relative;
    z-index: 20;
    font-family: "Courier New", monospace;
    font-size: 10px;
  }

  .editorial-header > a {
    color: #111;
    text-decoration: none;
  }

  .editorial-logo {
    text-align: center;
  }

  .menu {
    justify-self: end;
    position: relative;
  }

  .menu summary {
    cursor: pointer;
    list-style: none;
  }

  .menu summary::-webkit-details-marker {
    display: none;
  }

  .menu nav {
    position: absolute;
    top: 24px;
    right: -10px;
    min-width: 150px;
    padding: 18px;
    background: white;
    border: 1px solid #ddd;
    display: flex;
    flex-direction: column;
    gap: 17px;
  }

  .menu nav a {
    color: #111;
    text-decoration: none;
    font-size: 10px;
  }

  .menu nav a:hover {
    opacity: 0.5;
  }

  @media (max-width: 650px) {
    .header {
      height: auto;
      min-height: 80px;
      padding: 20px 6%;
      align-items: flex-start;
      gap: 20px;
      flex-direction: column;
    }

    .header nav {
      width: 100%;
      justify-content: space-between;
      gap: 10px;
    }

    .header nav a {
      font-size: 9px;
    }
  }
</style>